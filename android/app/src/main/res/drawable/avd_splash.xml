<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="mark"
                android:pivotX="54"
                android:pivotY="54">
                <group
                    android:scaleX="1.68"
                    android:scaleY="1.68"
                    android:translateX="33.84"
                    android:translateY="33.84">
                    <path
                        android:fillColor="@color/logo_foreground"
                        android:pathData="M4,20C4,10.6 10.6,4 20,4C20,13.4 13.4,20 4,20Z" />
                    <path
                        android:name="check"
                        android:pathData="M8,12.4L10.9,15.2L16.2,9.4"
                        android:strokeWidth="1.9"
                        android:strokeColor="@color/logo_background"
                        android:strokeLineCap="round"
                        android:strokeLineJoin="round"
                        android:trimPathEnd="0" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="350"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.8"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="350"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.8"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="check">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="250"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
