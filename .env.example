NODE_ENV=production
PORT=8080
# Jumlah proxy di depan API; 1 untuk Render, 0 untuk docker compose lokal.
TRUST_PROXY=0
DATABASE_URL=postgres://laporlh:laporlh@postgres:5432/laporlh

# Isi dengan nilai acak minimal 32 karakter, misalnya: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=laporlh-api
JWT_AUDIENCE=laporlh-mobile
ACCESS_TTL_SECONDS=300
DEVICE_KEY_TTL_SECONDS=2592000
NONCE_TTL_SECONDS=60
MAX_UPLOAD_BYTES=2097152

STORAGE_DRIVER=disk
STORAGE_DISK_PATH=/data/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

ADMIN_ENABLED=true
ADMIN_COOKIE_SECRET=
ADMIN_JS_SKIP_BUNDLE=true

BCRYPT_COST=12
NODE_OPTIONS=--max-old-space-size=384

SEED_ENABLED=true
SEED_OFFICER_EMAIL=petugas@laporlh.test
SEED_OFFICER_PASSWORD=
SEED_REVIEWER_EMAIL=verifikator@laporlh.test
SEED_REVIEWER_PASSWORD=
